# Copy to .env and run start.ps1. Never commit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TEMPERATURE=0.3
DEEPSEEK_BASE_URL=https://api.deepseek.com
SERVER_PORT=8080
AI_DAILY_LIMIT=100

# Optional bootstrap administrator (only creates an account that does not exist).
# Password must contain at least 12 characters; no default administrator password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Default uses a local H2 file database. For MySQL, create ai_chat first and uncomment:
# SPRING_PROFILES_ACTIVE=mysql
# DB_URL=jdbc:mysql://localhost:3306/ai_chat?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
# DB_USERNAME=root
# DB_PASSWORD=
# MySQL 5.7 only:
# DB_DIALECT=org.hibernate.community.dialect.MySQLLegacyDialect

# Runtime policies (restart required after editing .env).
# Fixed API field lengths and the 2..10 expansion count are not runtime settings.
DEEPSEEK_MAX_TOKENS=2400
AI_CONNECT_TIMEOUT=15s
AI_READ_TIMEOUT=120s
AI_QUOTA_ZONE=Asia/Shanghai
AI_EXTRACT_CANDIDATES=3
AI_RETRY_MAX_ATTEMPTS=2
AI_RETRY_INITIAL_INTERVAL=1s
AI_RETRY_MULTIPLIER=2
AI_RETRY_MAX_INTERVAL=5s
# Frontend request timeout is 145s; coordinate changes to long AI timeouts.
AUTH_SESSION_TTL=7d
AUTH_LOGIN_WINDOW=15m
AUTH_LOGIN_MAX_ATTEMPTS=30
TREE_MAX_NODES=3000
# Recursive traversal supports a maximum of 80 levels, including the root.
TREE_MAX_DEPTH=80
ADMIN_DISPLAY_NAME=管理员
ADMIN_RECENT_USAGE_LIMIT=100
TOPIC_SEED_ENABLED=true
TOPIC_DEFAULT_COLOR=#548b9d
# Use file:E:/config/topics.json (or prompt .txt) for external overrides.
TOPIC_SEED_LOCATION=classpath:seed/topics.json
AI_EXTRACT_PROMPT=classpath:prompts/extract.txt
AI_EXPAND_PROMPT=classpath:prompts/expand.txt
LOG_MAX_FILE_SIZE=10MB
LOG_MAX_HISTORY=30
LOG_TOTAL_SIZE_CAP=200MB
